# Nirmana talks to one ask-and-answer API. Copy this file to .env and fill in real values.
NIRMANA_API_URL=https://example.com/api/ask
NIRMANA_API_KEY=your_api_key

# Defaults assume POST JSON with Authorization: Bearer <key>.
NIRMANA_API_METHOD=POST
NIRMANA_AUTH_HEADER=Authorization
NIRMANA_AUTH_PREFIX=Bearer

# Request body will include this field plus user_id.
NIRMANA_REQUEST_QUESTION_FIELD=question

# Dot path used to read the answer from the API JSON response.
# Common examples: answer, data.answer, choices.0.message.content
NIRMANA_RESPONSE_ANSWER_PATH=answer

# Optional JSON object merged into every request body.
NIRMANA_API_EXTRA_JSON={}

NIRMANA_API_TIMEOUT_SECONDS=120
HTTP_REQUEST_TIMEOUT_SECONDS=180
NIRMANA_PORT=5184
